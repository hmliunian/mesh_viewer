# Virtual environments and local dependency caches
/.venv/
/venv/
/env/
/ENV/
.uv-cache/
__pypackages__/

# Python build and packaging artifacts
/build/
/dist/
*.egg-info/
.eggs/
*.egg

# Local configuration and secrets
.env
.env.*
!.env.example
*.log

# Editor and operating-system files
/.vscode/
/.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
